export PATH="/c/Program Files/nodejs:$PATH"

# Запобіжник (2026-10-05): у коміт потрапляють лише відомі теки верхнього
# рівня і жодних офісних документів. Локальні робочі матеріали (презентації,
# документи, чернетки) живуть поза git — у теках, перелічених у
# .git/info/exclude; той файл локальний, на іншому комп'ютері його нема, і
# `git add -A` затягнув би таку теку цілком. Ця перевірка їде разом із репо.
# Нова справжня тека проєкту = один рядок у allowed нижче.
allowed=" .claude .github .husky app components e2e hooks legacy lib prisma public types "
bad=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACR | awk -v allowed="$allowed" '
  {
    f = $0
    if (index(f, "/")) { top = f; sub(/\/.*/, "", top); if (index(allowed, " " top " ") == 0) print "  " f "  (нова тека верхнього рівня: " top ")" }
    if (tolower(f) ~ /\.(pptx|docx|xlsx|pdf)$/) print "  " f "  (офісний документ)"
  }')
if [ -n "$bad" ]; then
  echo "pre-commit: відхилено — ці файли не належать репозиторію:"
  echo "$bad"
  echo "Якщо тека справді потрібна в git — додайте її до allowed у .husky/pre-commit."
  exit 1
fi

npx lint-staged
