# Скопіюйте цей файл у .env (локально) і заповніть реальними значеннями.
# .env у git не комітиться (див. .gitignore) — самі значення завжди
# лишаються тільки на вашій машині або у Vercel → Project Settings →
# Environment Variables. Секрети вписує людина, не асистент (CLAUDE.md).

# Postgres (Neon). Локально — синтетична демо-база (SYNTHETIC_DEMO_DATABASE_URL
# нижче, DATABASE_URL зазвичай вказує на неї ж); у Vercel — бойова.
DATABASE_URL=
# Необов’язково: пряме (без -pooler) з’єднання лише для prisma migrate.
# Якщо порожньо — prisma7.config.mjs сам прибере "-pooler." з DATABASE_URL.
DIRECT_DATABASE_URL=
SYNTHETIC_DEMO_DATABASE_URL=

# Довгий випадковий рядок для підпису cookie-сесії співробітника
# (lib/session.js). `openssl rand -hex 32`. Різний на dev і prod.
SESSION_SECRET=

# Спільний пароль /admin (lib/adminSession.js) — окремий вхід від PIN.
ADMIN_PASSWORD=

# Пошта. За замовчуванням Resend (потрібен підтверджений домен, інакше листи
# лише на пошту власника акаунта). EMAIL_PROVIDER=gmail перемикає на Gmail SMTP
# (GMAIL_USER + App Password), і локально, і на проді — ліміт ~500 листів/добу.
# DEV_TEST_EMAIL_OVERRIDE — усі dev-листи на одну адресу.
# підтверджено. DEV_TEST_EMAIL_OVERRIDE — усі dev-листи на одну адресу.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_PROVIDER=
GMAIL_USER=
GMAIL_APP_PASSWORD=
DEV_TEST_EMAIL_OVERRIDE=

# Vercel Blob (фото уроків, app/api/admin/upload) — сховище має бути Public.
BLOB_READ_WRITE_TOKEN=

# Web Push (lib/webPush.js): `npx web-push generate-vapid-keys`.
# Без ключів push мовчки вимкнено, центр сповіщень працює.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Секрет cron-ендпоінтів (app/api/cron/*). Vercel Cron сам додає
# `Authorization: Bearer $CRON_SECRET`, якщо змінна задана в проєкті.
CRON_SECRET=

# Telegram-бот CarlsON (lib/telegram.ts) — ще один канал сповіщень поруч із
# push. Бота створює користувач у @BotFather (username має закінчуватись на
# "bot": CarlsON_bot); токен — сюди. Без токена канал мовчки вимкнено.
# TELEGRAM_WEBHOOK_SECRET — будь-який рядок (openssl rand -hex 16): Telegram
# шле його в заголовку кожного апдейту, webhook без нього не приймає.
# APP_URL — публічна адреса (кнопка «Відкрити» в повідомленні + webhook);
# на Vercel можна не задавати (береться VERCEL_PROJECT_PRODUCTION_URL).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CarlsON_bot
TELEGRAM_WEBHOOK_SECRET=
APP_URL=

# «Тестовий вхід» на екрані реєстрації (lib/demoLogin.ts): кома-список
# кодів демо-персон, під якими колеги можуть зайти, отримавши PIN на СВОЮ
# пошту. Порожньо/відсутнє = кнопки нема, demoEmail в API відкидається.
DEMO_LOGIN_CODES=
