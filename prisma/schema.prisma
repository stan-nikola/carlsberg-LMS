// Это файл схемы Prisma. Подробнее: https://pris.ly/d/prisma-schema
//
// Строка подключения к БД задаётся в prisma7.config.mjs (Prisma 7),
// а не здесь через url = env(...).

// Проект на JS без TypeScript: "prisma-client" (генератор по умолчанию в v7)
// эмитит .ts-исходники, поэтому используем "prisma-client-js" — тот же
// генератор, что был в v6, официально оставлен в v7 для JS-проектов
// (эмитит обычный .js + .d.ts, без исходников на TypeScript).
generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Роли и иерархия
// ---------------------------------------------------------------------

/// Должность в иерархии (RM → ASM → SV → SR → MR).
model Position {
  id    Int    @id @default(autoincrement())
  /// Код должности: "RM" | "ASM" | "SV" | "SR" | "MR"
  code  String @unique
  name  String
  /// Уровень в иерархии: 1 = RM (верх), 5 = MR (низ)
  level Int

  employees Employee[]
}

/// Территория/регион — используется для видимости и назначения курсов.
/// Иерархична (как Employee.managerId): RM-регион -> ASM-область ->
/// SV-район/город (см. prisma/import-territories.js).
model Territory {
  id   Int    @id @default(autoincrement())
  name String

  parentId Int?
  parent   Territory?  @relation("TerritoryHierarchy", fields: [parentId], references: [id])
  children Territory[] @relation("TerritoryHierarchy")

  employees Employee[]
}

/// Системная роль поверх иерархии должностей.
/// employee   — видимость по иерархии (managerId)
/// admin      — полный доступ
/// hr_manager — полный доступ (равнозначно admin, другая подпись в UI)
enum Role {
  employee
  admin
  hr_manager
}

model Employee {
  id    Int     @id @default(autoincrement())
  name  String
  /// Опційна: у польових ролей (МЧ, ТП, Технік тощо) особистої пошти
  /// зазвичай немає — PIN для входу йде на пошту керівника
  /// (employee.manager.email), не на власну. Реальна пошта є лише в
  /// менеджерського шару (SV/ASM/LKAM/RM HoReCa) — див. import-employees.js.
  email String? @unique
  role  Role    @default(employee)

  /// Код із зовнішньої системи (Monolit Agent) — те, що в legacy називалось
  /// User_Id. Разом із loginPin використовується для входу (ШАГ 3, вопрос А).
  externalCode String    @unique
  /// Поточний PIN для входу. Генерується заново при КОЖНОМУ запиті (в т.ч.
  /// "Надіслати ще раз") і одразу ж перезаписує попередній — а сам живе не
  /// довше pinIssuedAt + 12 годин (PIN_TTL_MS у lib/auth.js), далі
  /// недійсний. Висилається на пошту самого співробітника, якщо вона є, або
  /// на пошту керівника (employee.manager.email) — див. lib/auth.js.
  loginPin     String?
  pinIssuedAt  DateTime?
  /// Момент першого успішного входу (перше підтвердження PIN) — те, що в
  /// legacy показувалось як profile.registeredAt. createdAt тут не підходить:
  /// той проставляється, коли адмін заводить рядок Employee, а не коли
  /// співробітник вперше увійшов.
  firstLoginAt DateTime?

  positionId Int?
  position   Position? @relation(fields: [positionId], references: [id])

  territoryId Int?
  territory   Territory? @relation(fields: [territoryId], references: [id])

  /// Руководитель этого сотрудника (следующая ступень вверх по иерархии).
  managerId    Int?
  manager      Employee?  @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  /// Прямые подчинённые (следующая ступень вниз по иерархии).
  subordinates Employee[] @relation("EmployeeHierarchy")

  enrollments         Enrollment[]    @relation("EnrollmentEmployee")
  assignedEnrollments Enrollment[]    @relation("EnrollmentAssignedBy")
  notifications       Notification[]
  apiTokens           AdminApiToken[]
  badgesReceived      EmployeeBadge[] @relation("BadgeRecipient")
  badgesAwarded       EmployeeBadge[] @relation("BadgeAwardedBy")

  /// Soft-delete/деактивація для адмінського CRUD співробітників.
  /// Навмисно НЕ hard delete — Employee має self-relation (managerId/
  /// subordinates) і Enrollment/Notification без onDelete: Cascade, а
  /// джерело даних (зовнішня система) реальних людей теж не видаляє,
  /// лише перейменовує/деактивує. Деактивований співробітник не може
  /// залогінитись (lib/auth.js), але вся історія (підлеглі, enrollments,
  /// бейджі) лишається цілою й оборотною.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Курсы
// ---------------------------------------------------------------------

model Course {
  id          Int     @id @default(autoincrement())
  /// Для чистых URL курса (/courses/[slug]) — например "assortment".
  slug        String  @unique
  title       String
  description String?

  isMandatory  Boolean @default(false)
  /// Сколько дней даётся на прохождение с момента назначения (используется
  /// для расчёта Enrollment.dueDate).
  deadlineDays Int?

  /// Тема курсу — показується як тег на картці курсу в хабі
  /// (components/CourseTile.jsx). Обирається зі списку в /admin
  /// (lib/courseCategories.js — єдине джерело правди для допустимих
  /// значень); null для курсів без теми (тег просто не рендериться).
  /// Свідомо звичайний String, не enum/окрема таблиця — значень поки
  /// одне ("Продажі"), окрема таблиця була б передчасною складністю.
  category String?

  /// Мотиваційні тости за серію правильних відповідей поспіль (streak) під
  /// час проходження тестів курсу — портовано з попередньої vanilla-JS
  /// розробки "8 кроків телесейлінгу" (з конфеті-анімацією, lib/streakMessages.js
  /// містить реальний текст звідти як дефолт). Масив
  /// { threshold, repeatEvery, icon, title, sub } — редагується в /admin
  /// (components/AdminDashboard.jsx, кнопка "+ Додати страйк-рейт з
  /// мотивуванням"). null/порожньо — курс бере DEFAULT_STREAK_MESSAGES.
  streakMessages Json?

  /// Код должностей, кому курс назначается по умолчанию (например ["SR","MR"]).
  targetPositions   String[] @default([])
  /// Id территорий, если курс назначается не всем, а конкретному региону.
  targetTerritories Int[]    @default([])
  /// Id конкретных співробітників — точкове призначення в обхід
  /// posada/territoryId (потрібне для польових ролей ТП/Мерчендайзер/
  /// Технік, яких імпорт зміг прив'язати по territoryId лише до цілого
  /// RM-регіону, не до конкретного СВ-району — див. CLAUDE.md; тут можна
  /// обрати саме людину, побачивши її в реальній оргструктурі
  /// managerId в components/TerritoryPicker.jsx). Об'єднується (не
  /// замінює) з призначенням по positions/territories.
  targetEmployeeIds Int[]    @default([])

  /// Дата, с которой курс нужно авто-назначить сотрудникам по
  /// targetPositions/targetTerritories — обрабатывается ежедневным cron
  /// (lib/courseAssignment.js publishScheduledCourses, вызывается из
  /// app/api/cron/check-overdue-enrollments/route.js). null — не
  /// запланировано, назначается только вручную кнопкой в /admin.
  publishAt      DateTime?
  /// Момент, когда авто-назначение по publishAt реально сработало — чтобы
  /// cron не назначал курс повторно каждый день (Enrollment.createMany и
  /// так skipDuplicates, но это лишняя работа + нужен явный статус
  /// "заплановано"/"опубліковано" в /admin).
  autoAssignedAt DateTime?

  modules     Module[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Модуль курсу — проміжне угруповання між Course і Screen (Курс -> Модуль ->
/// Екран -> Компонент), напр. курс "Адаптація мерчендайзерів" з модулями
/// "Асортимент", далі ще модулі. Прогрес/залік (Enrollment) рахується по
/// КУРСУ в цілому, не по модулю — модуль лише групує екрани для навігації
/// (як розділи книги), не окрема залікова одиниця.
/// (До 2026-09: цей рівень називався "Block" — перейменовано разом із
/// переходом на структуру Course -> Module -> Screen -> Component, де
/// старий "Module" став "Screen", а старий "Lesson" — "Component".)
model Module {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String
  order Int    @default(0)

  /// "Пауза між модулями" — скільки днів має минути з моменту, як
  /// співробітник СКЛАВ (пройшов з прохідним балом) ПОПЕРЕДНІЙ модуль курсу,
  /// перш ніж цей модуль відкриється. null/0 — відкривається одразу, як
  /// тільки попередній складено (без додаткової паузи). На перший модуль
  /// курсу не впливає (немає попереднього). Обчислення —
  /// app/courses/[slug]/page.js, факт складання — ModuleCompletion.
  cooldownDays Int?

  /// "Пауза перед повторним проходженням" — скільки днів має минути з
  /// моменту, як співробітник СКЛАВ (passed=true) цей модуль, перш ніж
  /// зможе перепройти його ще раз (реальний тест із питаннями). На
  /// провалений модуль (passed=false) НЕ впливає — той, як і раніше,
  /// можна перепройти одразу (ModuleCheckpointScreen). Поки немає
  /// повторного проходження — модуль просто пропускається при вході в
  /// курс (не змушує переграти вже складене), а якщо жоден модуль курсу
  /// не потребує проходження — показується курс-методичка (тільки
  /// контент, без тестів/гейтів, components/CourseReview.jsx). null —
  /// використовується дефолт (RETAKE_COOLDOWN_DAYS_DEFAULT, lib/courseContent.js).
  retakeCooldownDays Int?

  screens     Screen[]
  completions ModuleCompletion[]
}

/// Факт складання модуля конкретним співробітником (в рамках конкретного
/// Enrollment) — потрібен, щоб рахувати "Паузу між модулями" (Module.cooldownDays)
/// від РЕАЛЬНОЇ дати, коли людина склала тести модуля, а не від дати
/// призначення курсу. passed=false лишається в історії (спроба була,
/// не склав) — при повторній спробі перезаписується (upsert), тому
/// completedAt/scorePercent завжди відображають ОСТАННЮ спробу.
model ModuleCompletion {
  id           Int        @id @default(autoincrement())
  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     Int
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  scorePercent Int
  passed       Boolean
  completedAt  DateTime @default(now())
  /// Найдовша серія поспіль правильних відповідей У МЕЖАХ ЦЬОГО МОДУЛЯ —
  /// той самий показник, що вже є на Enrollment (для курсу в цілому), але
  /// одиницею на модуль: раніше керівник бачив 🎯-стрик лише по курсу
  /// цілком, тепер, коли курс сам по собі — кілька модулів, потрібно й на
  /// рівні кожного з них. null для завершень, записаних до цього поля
  /// (не вигадуємо заднім числом — просто немає даних).
  longestCorrectStreak Int?
  /// Точні лічильники за цей модуль (не лише округлений scorePercent) —
  /// потрібні, щоб коли курс проходиться ЧАСТИНАМИ в кілька сесій (модуль
  /// А складено сьогодні, модуль Б — за тиждень), фінальний бал курсу
  /// (Enrollment.scoreRaw/scoreMax) можна було ТОЧНО скласти з балів
  /// окремих модулів, а не лише з тих quiz-компонентів, що були в
  /// поточній сесії плеєра (lib/courseContent.js getPlayableModules —
  /// уже пройдені й не готові до перепроходження модулі не потрапляють у
  /// поточну сесію взагалі). null для завершень, записаних до цих полів.
  scoreRaw Int?
  scoreMax Int?

  @@unique([enrollmentId, moduleId])
}

/// Екран курсу — те, що співробітник реально бачить і гортає "Далі"/"Назад"
/// у плеєрі. Один Screen складається з кількох Component (питання, інфо,
/// акордеон, фото, поле-інпут, таймлайн тощо), розставлених у порядку —
/// на відміну від старої моделі, де один Lesson був одним типом/екраном.
model Screen {
  id       Int    @id @default(autoincrement())
  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title String
  order Int    @default(0)

  /// Календарне відкриття по днях (unlockAfterDays) свідомо прибрали з
  /// цього рівня (2026-09) — на запит користувача: ця функція потрібна
  /// лише на рівні Module (Module.cooldownDays, "Пауза між модулями"),
  /// не для кожного окремого екрана.
  components Component[]
}

/// info — информационный блок (текст/картинка); quiz — вопрос с вариантами
/// ответа. Типи компонентів екрана. info/quiz були з самого початку; решта —
/// інтерактивні механіки, портовані з попередньої vanilla-JS розробки
/// ("8 кроків телесейлінгу"): кожна має свій "гейт" — кнопка «Далі»
/// лишається заблокованою, поки співробітник реально не провзаємодіє з
/// НЕЮ (усі компоненти екрана мають бути "пройдені" — див.
/// lib/componentTypes.js, єдине джерело правди і для плеєра, і для
/// прев'ю в /admin). photo/input додані разом з переходом на
/// Screen -> Component (2026-09): photo — фото без гейта; input —
/// довільний текст, гейт "щось введено", значення НІКУДИ не зберігається.
enum ComponentType {
  info
  quiz
  /// Кілька карток-акордеонів; гейт — відкрити всі.
  accordion
  /// Чек-лист; гейт — позначити всі пункти.
  checklist
  /// Діалог-скрипт дзвінка: репліки відкриваються по одній; гейт — дочитати.
  script
  /// Таймлайн кроків; гейт — торкнутись кожного (або лише підсвіченого,
  /// якщо content.highlight задано — режим "ви тут" із legacy recap).
  timeline
  /// Самостійне фото (без інфо-тексту навколо); гейта немає.
  photo
  /// Довільне текстове поле; гейт — не порожнє значення. Введений текст
  /// ніде не зберігається (лише розблоковує «Далі» на цьому екрані).
  input
}

model Component {
  id       Int    @id @default(autoincrement())
  screenId Int
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  type  ComponentType @default(info)
  /// Обов'язковий лише для quiz (буквальний текст питання, показується як
  /// <h2> у плеєрі) — решта типів тримають свій заголовок/lead усередині
  /// content і title можуть лишати порожнім.
  title String?
  order Int           @default(0)

  /// Структура зависит от type — редактируется отдельно от кода (без
  /// редеплоя):
  /// info: { body: string, imageUrl?: string }
  /// quiz: { questionType: "single" | "multi",
  ///         options: [{ text: string, correct: boolean }] }
  content Json
}

// ---------------------------------------------------------------------
// Назначения курсов
// ---------------------------------------------------------------------

enum EnrollmentStatus {
  not_started
  in_progress
  completed
  overdue
}

model Enrollment {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation("EnrollmentEmployee", fields: [employeeId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  /// Кто назначил курс (обычно admin/RM).
  assignedById Int
  assignedBy   Employee @relation("EnrollmentAssignedBy", fields: [assignedById], references: [id])

  /// Дата назначения (было enrolledAt — переименовано для ясности: это
  /// момент назначения курса, а не момент, когда сотрудник сам начал его
  /// проходить).
  assignedAt  DateTime  @default(now())
  /// Дедлайн = assignedAt + course.deadlineDays на момент назначения
  /// (пересчитывается только при новом назначении, не задним числом).
  dueDate     DateTime?
  /// Копия course.isMandatory на момент назначения — чтобы будущие
  /// изменения course.isMandatory не меняли задним числом уже созданные
  /// назначения.
  isMandatory Boolean   @default(false)

  status EnrollmentStatus @default(not_started)

  /// Сводка по последней попытке (полная история — в EnrollmentAttempt).
  /// Заполняется при завершении курса из данных попытки.
  completedAt          DateTime?
  scoreRaw             Int?
  scoreMax             Int?
  scorePercent         Int?
  passed               Boolean?
  durationSeconds      Int?
  activeTimeSeconds    Int?
  longestCorrectStreak Int?

  attempts          EnrollmentAttempt[]
  moduleCompletions ModuleCompletion[]

  /// Аудит-слід ручної корекції адміном (Фаза D адмінки) — чому статус/бал
  /// був змінений вручну (напр. "пройшов офлайн, підтверджено керівником").
  /// null — жодного разу не корегувалось вручну.
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, courseId])
  /// Для дневной cron-задачи, которая ищет просроченные назначения.
  @@index([status, dueDate])
}

/// Полная история попыток прохождения курса (курс можно проходить
/// повторно — "Пройти ще раз" в legacy). Enrollment хранит только сводку
/// по последней попытке для быстрого доступа (карточки/отчёты); сюда
/// пишется каждая попытка отдельной строкой.
model EnrollmentAttempt {
  id           Int        @id @default(autoincrement())
  enrollmentId Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  startedAt   DateTime
  completedAt DateTime

  durationSeconds      Int
  activeTimeSeconds    Int
  scoreRaw             Int
  scoreMax             Int
  scorePercent         Int
  passed               Boolean
  longestCorrectStreak Int

  createdAt DateTime @default(now())

  @@index([enrollmentId])
}

model Notification {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  type    String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
}

/// Токен для "живого" Excel-підключення (Фаза B3 адмінки) — Power Query
/// (Data > Get Data > From Web) тягне JSON з app/api/data/*, авторизуючись
/// заголовком Authorization: Bearer <токен>, окремо від admin_session
/// cookie (та прив'язана до браузера, не переживе відкриття Excel).
/// ОБОВ'ЯЗКОВО прив'язаний до конкретного Employee з role admin/hr_manager
/// (не до анонімної /admin-сесії) — саме так з'являється "прив'язка до
/// email", яку просив користувач: сама /admin-сесія спільна на пароль, а
/// токен — персональний, видається конкретній людині з реальною поштою.
/// Сирий токен показується ОДИН раз у момент створення (UI), у базі —
/// лише sha256-хеш (той самий принцип, що з паролями: не зберігати
/// секрет у відкритому вигляді навіть свій згенерований).
model AdminApiToken {
  id         Int       @id @default(autoincrement())
  /// Підпис для людини ("Excel — Станіслав Карманов") — не сам токен.
  label      String?
  tokenHash  String    @unique
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

// ---------------------------------------------------------------------
// Ачивки/заслуги (Фаза C адмінки)
// ---------------------------------------------------------------------

/// manual — адмін вручну створює тип і видає конкретній людині (аналог
/// "kudos"/spot-award у Lattice/Culture Amp). auto — нараховується самому
/// щоденним cron за реальними даними (lib/badgeRules.js), як у
/// Duolingo/Salesforce Trailhead.
enum BadgeKind {
  manual
  auto
}

/// Тип ачивки/заслуги — сам "значок", ще не прив'язаний до людини
/// (прив'язка — EmployeeBadge нижче). Для kind=auto ruleKey вказує, яку
/// функцію з lib/badgeRules.js рахувати; для kind=manual ruleKey — null,
/// адмін видає вручну з картки співробітника.
model Badge {
  id          Int             @id @default(autoincrement())
  /// Стабільний ключ — для auto badge_rules.js звертається саме по ньому,
  /// не по назві (назву адмін може перейменувати, не ламаючи авто-правило).
  code        String          @unique
  title       String
  description String?
  /// emoji або ключ SVG-іконки — той самий підхід, що вже є в
  /// AchievementsPanel.jsx (badge-ico), не нова система іконок.
  icon        String?
  kind        BadgeKind
  ruleKey     String?
  createdAt   DateTime        @default(now())
  awards      EmployeeBadge[]
}

/// Факт видачі конкретної ачивки конкретній людині. @@unique — і захист
/// від дублів при повторному прогоні auto-правил (cron може безпечно
/// прогонятись хоч щодня), і природне обмеження "одна й та сама ачивка
/// людині — один раз" для manual (повторна видача = помилка UI, не нова
/// заслуга).
model EmployeeBadge {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation("BadgeRecipient", fields: [employeeId], references: [id])
  badgeId     Int
  badge       Badge     @relation(fields: [badgeId], references: [id])
  awardedAt   DateTime  @default(now())
  /// null — нараховано авто-правилом (система), не людиною.
  awardedById Int?
  awardedBy   Employee? @relation("BadgeAwardedBy", fields: [awardedById], references: [id])
  /// Текст "заслуги" при ручній видачі (напр. "За рекордний квартал") —
  /// для auto зазвичай порожній, самого факту досягнення достатньо.
  note        String?

  @@unique([employeeId, badgeId])
}
