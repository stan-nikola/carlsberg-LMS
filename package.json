{
  "name": "carlsberg-lms-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = production ]; then prisma migrate deploy || exit 1; fi; next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
